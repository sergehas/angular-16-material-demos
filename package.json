{
  "name": "angular-16-material-starter",
  "version": "21.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:no-reload": "ng serve --no-hmr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npx prettier **/* --write --ignore-unknown",
    "lint:fix": "ng lint --fix",
    "lint:only": "ng lint",
    "pretty": "npx prettier **/* --write --ignore-unknown",
    "clean": "rimraf coverage playwright-report test-results node_modules",
    "build:iconLib": "node ./buildIconLib.js",
    "e2e": "ng e2e",
    "e2e:ui": "ng e2e --ui",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/material-moment-adapter": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "uuid": "^13.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.0",
    "@eslint/json": "^1.0.0",
    "@playwright/test": "^1.58.0",
    "@types/events": "^3.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^24.0.0",
    "angular-eslint": "~21.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.0",
    "jasmine-core": "~6.1.0",
    "jasmine-marbles": "~0.9.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^16.3.0",
    "playwright-ng-schematics": "^21.0.0",
    "prettier": "~3.8.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.56.0"
  },
  "lint-staged": {
    "*.{mjs,json,css,scss,md,ts,html}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "consistent"
  }
}
